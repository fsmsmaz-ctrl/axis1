// AXIS Pipe Jacking Management System - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== Users & Auth ====================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  nameEn       String?
  phone        String?
  role         String   @default("site_engineer") // top_management, project_manager, site_engineer, hse_officer, foreman, accountant
  avatar       String?
  active       Boolean  @default(true)
  language     String   @default("ar") // ar, en
  permissions  Json?    // Custom per-user permission overrides: { drive_lines: true, rpt_daily_site: false, ... }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectsManaged    Project[]   @relation("ProjectManager")
  projectsEngineered Project[]   @relation("SiteEngineer")
  dailyReports       DailyReport[] @relation("ReportCreator")
  approvedReports    DailyReport[] @relation("ReportApprover")
  safetyReports      SafetyReport[]  @relation("SafetyReportSigner")
  costs              Cost[]
  equipmentsMaint    EquipmentMaintenance[]
  finishings         Finishing[]
  finishingsSubmitted Finishing[] @relation("FinishingSubmitter")
  finishingsApproved  Finishing[] @relation("FinishingApprover")
  notifications      Notification[]
  auditLogs          AuditLog[]
  companyAssets      CompanyAsset[]  @relation("AssetResponsible")
  equipmentsCreated  Equipment[]       @relation("EquipmentCreator")
  assetsCreated      CompanyAsset[]   @relation("AssetCreator")
  workersCreated      Worker[]         @relation("WorkerCreator")
  tasksAssigned       Task[]           @relation("TaskAssignee")
  tasksCreated        Task[]           @relation("TaskCreator")
  tasksClosed         Task[]           @relation("TaskCloser")
  tasksLastUpdated    Task[]           @relation("TaskLastUpdater")
  taskEvents          TaskEvent[]      @relation("TaskEventActor")
  taskAttachments     TaskAttachment[] @relation("TaskAttachmentUploader")
}

// ==================== Projects ====================
model Project {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  client         String
  location       String
  contractNumber String?
  workType       String   // pipe_jacking, microtunneling, hdd, auger_boring
  pipeDiameter   String   // 800mm, 1000mm, 1200mm, other
  totalLength    Float    // meters
  pricePerMeter  Float    // OMR
  soilType       String   // soft, hard, rocky, mixed
  startDate      DateTime
  expectedEnd    DateTime
  actualEnd      DateTime?
  status         String   @default("not_started") // not_started, in_progress, suspended, completed
  progress       Float    @default(0) // 0-100
  notes          String?

  managerId      String?
  engineerId     String?
  manager        User?    @relation("ProjectManager", fields: [managerId], references: [id])
  engineer       User?    @relation("SiteEngineer", fields: [engineerId], references: [id])

  driveLines     DriveLine[]
  dailyReports   DailyReport[]
  safetyReports  SafetyReport[]
  costs          Cost[]
  equipments     Equipment[]
  finishings     Finishing[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  companyAssets  CompanyAsset[]
  workers        Worker[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==================== Drive Lines ====================
model DriveLine {
  id            String   @id @default(cuid())
  projectId     String
  lineNumber    String
  startPoint    String
  endPoint      String
  totalLength   Float    // meters
  diameter      String
  pipeType      String   // pipe, sleeve
  soilType      String
  depth         Float    // meters
  status        String   @default("not_started") // not_started, in_progress, completed, suspended
  completedLength Float  @default(0)
  progress      Float    @default(0) // 0-100
  problems      String?

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyReports  DailyReport[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== Daily Reports ====================
model DailyReport {
  id              String   @id @default(cuid())
  projectId       String
  driveLineId     String?
  reportDate      DateTime
  weather         String?  // sunny, cloudy, rainy, windy
  workStartTime   String?  // HH:mm
  workEndTime     String?  // HH:mm
  operatingHours  Float    @default(0)
  stoppageHours   Float    @default(0)
  stoppageReason  String?
  workersCount    Int      @default(0)
  attendees       String?  // JSON string of workers list
  absentees       String?
  attendanceNotes String?

  // Production data
  startReading    Float    @default(0) // meter
  endReading      Float    @default(0) // meter
  dailyMeters     Float    @default(0)
  totalMeters     Float    @default(0)
  remainingMeters Float    @default(0)
  progressPercent Float    @default(0)
  soilExcavated   String?
  pipesInstalled  Int      @default(0)
  productionNotes String?
  problems        String?

  // Revenue (auto-calculated)
  dailyRevenue    Float    @default(0)

  status          String   @default("draft") // draft, submitted, approved, rejected
  approvedById    String?
  approvedAt      DateTime?

  // Immutability flag: when true, fields set by safety report cannot be modified
  safetyLocked    Boolean  @default(false)

  createdById     String?
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  driveLine       DriveLine? @relation(fields: [driveLineId], references: [id])
  createdBy       User?    @relation("ReportCreator", fields: [createdById], references: [id])
  approver        User?    @relation("ReportApprover", fields: [approvedById], references: [id])
  safety          SafetyReport?
  costs           Cost[]
  attachments     Attachment[]
  auditLogs       AuditLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== Safety Reports ====================
model SafetyReport {
  id                  String   @id @default(cuid())
  dailyReportId       String   @unique
  projectId           String
  reportDate          DateTime

  // Checklist items (boolean)
  ppeAvailable        Boolean  @default(false)
  helmetCheck         Boolean  @default(false)
  bootsCheck          Boolean  @default(false)
  glovesCheck         Boolean  @default(false)
  glassesCheck        Boolean  @default(false)
  workAreaCheck       Boolean  @default(false)
  barriersCheck       Boolean  @default(false)
  shaftCheck          Boolean  @default(false)
  ventilationCheck    Boolean  @default(false)
  electricalCheck     Boolean  @default(false)
  craneCheck          Boolean  @default(false)
  hydraulicCheck      Boolean  @default(false)
  fireExtinguishers   Boolean  @default(false)
  workPermit          Boolean  @default(false)
  toolboxTalk         Boolean  @default(false)

  hazards             String?  // JSON list
  observations        String?
  violations          String?
  incidentType        String?  // none, near_miss, incident, accident
  incidentDescription String?

  signedBy            String?
  signedById          String?
  signedAt            DateTime?

  dailyReport         DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  project             Project  @relation(fields: [projectId], references: [id])
  signedByUser        User?    @relation("SafetyReportSigner", fields: [signedById], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ==================== Equipment ====================
model Equipment {
  id              String   @id @default(cuid())
  projectId       String?
  name            String
  number          String   @unique
  type            String   // jacking_machine, crane, excavator, pump, etc.
  status          String   @default("operational") // operational, stopped, maintenance_needed
  dailyHours      Float    @default(0)
  breakdowns      String?  // JSON list of breakdowns
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  spareParts      String?
  notes           String?
  createdById     String?

  project         Project? @relation(fields: [projectId], references: [id])
  maintenance     EquipmentMaintenance[]
  createdBy       User?    @relation("EquipmentCreator", fields: [createdById], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EquipmentMaintenance {
  id            String   @id @default(cuid())
  equipmentId   String
  date          DateTime
  type          String   // routine, repair, emergency
  description   String
  cost          Float    @default(0)
  partsUsed     String?
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
}

// ==================== Costs ====================
model Cost {
  id            String   @id @default(cuid())
  projectId     String
  dailyReportId String?
  date          DateTime
  category      String   // labor, housing, transport, fuel, maintenance, parts, oil, safety, rental, other
  description   String
  amount        Float
  notes         String?

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyReport   DailyReport? @relation(fields: [dailyReportId], references: [id])
  recordedBy    User?    @relation(fields: [recordedById], references: [id])
  recordedById  String?

  createdAt     DateTime @default(now())
}

// ==================== Finishing / Handover ====================
model Finishing {
  id              String   @id @default(cuid())
  projectId       String
  driveLineId     String?
  date            DateTime
  siteCleaned     Boolean  @default(false)
  wasteRemoved    Boolean  @default(false)
  shaftClosed     Boolean  @default(false)
  siteRestored    Boolean  @default(false)
  lineHandover    Boolean  @default(false)
  casingSpacer    Boolean  @default(false) // حشوة الكيسنج (سبيسر) — Casing Spacer
  clientNotes     String?
  handoverStatus  String   @default("pending") // pending, accepted, needs_revision, rejected
  signedBy        String?
  signedById      String?
  signedAt        DateTime?

  // دورة اعتماد الإدارة (مطابقة لدورة التقارير اليومية):
  // draft (مسودة لدى المشرف) → submitted (مرفوعة للإدارة) → approved (معتمد) / rejected (مرفوض)
  status          String   @default("draft") // draft, submitted, approved, rejected
  submittedById   String?  // المشرف الذي رفع التشطيب للإدارة
  submittedAt     DateTime?
  approvedById    String?  // الإداري / مدير المشروع / مدير النظام الذي اعتمد أو رفض
  approvedAt      DateTime?
  reviewNotes     String?  // سبب الرفض — يظهر للمشرف ليعدل بناءً عليه

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signedByUser    User?    @relation(fields: [signedById], references: [id])
  submitter       User?    @relation("FinishingSubmitter", fields: [submittedById], references: [id])
  approver        User?    @relation("FinishingApprover", fields: [approvedById], references: [id])
  attachments     Attachment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== Task Management (إدارة المهام) ====================
// دورة حياة المهمة:
//   new (جديدة) → in_progress (قيد التنفيذ) → waiting (بانتظار جهة أخرى، بسبب مسجّل)
//   → ready_review (جاهزة للمراجعة) → closed (مغلقة نهائياً من الإدارة)
//   returned (معادة للتعديل من الإدارة) / cancelled (ملغاة مع سبب — لا تُحذف أبداً)
// كل الانتقالات تُسجَّل في TaskEvent مع الفاعل والوقت (سجل كامل للتدقيق وتقييم الأداء)
model Task {
  id                String    @id @default(cuid())
  taskNumber        Int       @unique @default(autoincrement()) // رقم المهمة التسلسلي
  title             String
  description       String?   // تفاصيل اختيارية
  category          String?   // القسم / نوع المهمة (اختياري)
  priority          String    @default("normal") // urgent, high, normal, low
  size              String    @default("medium") // small, medium, large — يُستخدم في تقرير الأداء
  status            String    @default("new") // new, in_progress, waiting, ready_review, returned, closed, cancelled
  dueDate           DateTime  // تاريخ ووقت الإنجاز المطلوب

  assigneeId        String    // الموظف المسؤول
  creatorId         String    // مَن أضاف المهمة

  // طوابع زمنية تلقائية لدورة الحياة
  startedAt         DateTime? // بدء التنفيذ
  reviewRequestedAt DateTime? // الإرسال للمراجعة
  closedAt          DateTime? // الإغلاق النهائي
  cancelledAt       DateTime?
  closedById        String?

  // بيانات التقييم
  closedOnFirstReview Boolean @default(false) // اعتُمدت من أول مراجعة بلا إعادة
  returnCount       Int       @default(0)      // عدد مرات الإعادة للتعديل
  reviewNote        String?   // ملاحظة الموظف عند الإرسال للمراجعة
  waitingMinutes    Int       @default(0)      // مجموع مدد الانتظار المكتملة — لا تُحسب تأخيراً على الموظف
  waitingSince      DateTime? // بداية الانتظار الحالي (أثناء حالة waiting)
  waitingReason     String?   // سبب الانتظار (إلزامي عند حالة الانتظار)
  cancelReason      String?   // سبب الإلغاء (إلزامي) — المهمة لا تُحذف

  // المهام الدورية: عند الإغلاق تُنشأ المهمة التالية تلقائياً
  recurring         String?   // daily, weekly, monthly, yearly
  parentTaskId      String?   // رأس السلسلة (المهمة الأصلية)

  lastUpdatedById   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assignee     User             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator      User             @relation("TaskCreator", fields: [creatorId], references: [id])
  closedBy     User?            @relation("TaskCloser", fields: [closedById], references: [id])
  lastUpdatedBy User?           @relation("TaskLastUpdater", fields: [lastUpdatedById], references: [id])
  events       TaskEvent[]
  attachments  TaskAttachment[]

  @@index([assigneeId, status])
  @@index([status, dueDate])
  @@index([dueDate])
}

// سجل كامل لكل تغيير (حالة / موعد إنجاز / مسؤول / ملاحظة / مرفق)
model TaskEvent {
  id            String    @id @default(cuid())
  taskId        String
  actorId       String
  type          String    // created, status_change, due_date_change, assignee_change, note, attachment, review, approved, returned, cancelled, recurring_spawn
  fromStatus    String?
  toStatus      String?
  oldDueDate    DateTime?
  newDueDate    DateTime?
  oldAssigneeId String?
  newAssigneeId String?
  note          String?   // سبب الانتظار / سبب الإعادة / الإجراء المنفذ / سبب الإلغاء
  createdAt     DateTime  @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation("TaskEventActor", fields: [actorId], references: [id])

  @@index([taskId, createdAt])
}

// مرفقات المهمة (اختيارية) — صور/ملفات بصيغة base64 مثل باقي النظام
model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  uploaderId String
  fileName   String
  fileType   String   // image, pdf, doc
  url        String   // base64 data URL أو مسار
  size       Int?
  createdAt  DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation("TaskAttachmentUploader", fields: [uploaderId], references: [id])

  @@index([taskId])
}

// ==================== Attachments ====================
model Attachment {
  id            String   @id @default(cuid())
  type          String   // site_photo, drilling_photo, safety_photo, finishing_photo, contract, po, invoice, report, worker_doc, certificate
  fileName      String
  fileType      String   // image, pdf, doc
  url           String   // base64 or path
  size          Int?
  dailyReportId String?
  finishingId   String?

  dailyReport   DailyReport? @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  finishing     Finishing?   @relation(fields: [finishingId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
}

// ==================== Notifications ====================
model Notification {
  id          String   @id @default(cuid())
  projectId   String?
  userId      String?  // المستخدم المستهدف تحديداً؛ null = إشعار عام
  type        String   // report_pending_approval, report_approved, report_delay, safety_missing, drive_line_completed, finishing_incomplete, performance_ready, project_created, cost_overrun, safety_alert...
  title       String
  message     String
  severity    String   @default("info") // info, warning, critical
  read        Boolean  @default(false)
  link        String?  // الصفحة التي يفتحها التنبيه (PageId): dailyReports, driveLines, finishings, performance...
  entityType  String?  // نوع الكيان المرتبط: daily_report, drive_line, finishing, safety_report, performance
  entityId    String?  // معرف الكيان المرتبط — يُستخدم لمنع تكرار التنبيهات
  createdAt   DateTime @default(now())

  project     Project? @relation(fields: [projectId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([type, entityId])
}

// ==================== Audit Log ====================
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  projectId   String?
  dailyReportId String?
  action      String   // create, update, delete, approve, reject
  entity      String   // project, drive_line, daily_report, safety_report, cost, equipment, finishing
  entityId    String
  details     String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])
  dailyReport DailyReport? @relation(fields: [dailyReportId], references: [id])
}

// ==================== Workers (Safety & Labor) ====================
model Worker {
  id            String   @id @default(cuid())
  projectId     String?
  name          String
  phone         String
  contractorName String?
  notes         String?
  createdById   String?

  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User?    @relation("WorkerCreator", fields: [createdById], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== Company Assets & Rentals ====================
model CompanyAsset {
  id             String   @id @default(cuid())
  projectId      String?
  name           String
  itemType       String
  quantity       Int      @default(1)
  ownership      String
  supplier       String?
  rentalCost     Float?
  rentalStart    DateTime?
  rentalEnd      DateTime?
  responsibleId  String?
  status         String   @default("available")
  notes          String?
  createdById    String?

  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible    User?    @relation("AssetResponsible", fields: [responsibleId], references: [id])
  createdBy      User?    @relation("AssetCreator", fields: [createdById], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


