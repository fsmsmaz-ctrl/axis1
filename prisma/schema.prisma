// AXIS Pipe Jacking Management System - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== Users & Auth ====================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  nameEn       String?
  phone        String?
  role         String   @default("site_engineer")
  avatar       String?
  active       Boolean  @default(true)
  language     String   @default("ar")
  permissions  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectsManaged    Project[]   @relation("ProjectManager")
  projectsEngineered Project[]   @relation("SiteEngineer")
  dailyReports       DailyReport[] @relation("ReportCreator")
  approvedReports    DailyReport[] @relation("ReportApprover")
  safetyReports      SafetyReport[]  @relation("SafetyReportSigner")
  costs              Cost[]
  equipmentsMaint    EquipmentMaintenance[]
  finishings         Finishing[]
  notifications      Notification[]
  auditLogs          AuditLog[]
companyAssets      CompanyAsset[]  @relation("AssetResponsible")
}

// ==================== Projects ====================
model Project {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  client         String
  location       String
  contractNumber String?
  workType       String
  pipeDiameter   String
  totalLength    Float
  pricePerMeter  Float
  soilType       String
  startDate      DateTime
  expectedEnd    DateTime
  actualEnd      DateTime?
  status         String   @default("not_started")
  progress       Float    @default(0)
  notes          String?

  managerId      String?
  engineerId     String?
  manager        User?    @relation("ProjectManager", fields: [managerId], references: [id])
  engineer       User?    @relation("SiteEngineer", fields: [engineerId], references: [id])

  driveLines     DriveLine[]
  dailyReports   DailyReport[]
  safetyReports  SafetyReport[]
  costs          Cost[]
  equipments     Equipment[]
  finishings     Finishing[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==================== Drive Lines ====================
model DriveLine {
  id            String   @id @default(cuid())
  projectId     String
  lineNumber    String
  startPoint    String
  endPoint      String
  totalLength   Float
  diameter      String
  pipeType      String
  soilType      String
  depth         Float
  status        String   @default("not_started")
  completedLength Float  @default(0)
  progress      Float    @default(0)
  problems      String?

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyReports  DailyReport[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== Daily Reports ====================
model DailyReport {
  id              String   @id @default(cuid())
  projectId       String
  driveLineId     String?
  reportDate      DateTime
  weather         String?
  workStartTime   String?
  workEndTime     String?
  operatingHours  Float    @default(0)
  stoppageHours   Float    @default(0)
  stoppageReason  String?
  workersCount    Int      @default(0)
  attendees       String?
  absentees       String?
  attendanceNotes String?

  startReading    Float    @default(0)
  endReading      Float    @default(0)
  dailyMeters     Float    @default(0)
  totalMeters     Float    @default(0)
  remainingMeters Float    @default(0)
  progressPercent Float    @default(0)
  soilExcavated   String?
  pipesInstalled  Int      @default(0)
  productionNotes String?
  problems        String?

  dailyRevenue    Float    @default(0)

  status          String   @default("draft")
  approvedById    String?
  approvedAt      DateTime?

  createdById     String?
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  driveLine       DriveLine? @relation(fields: [driveLineId], references: [id])
  createdBy       User?    @relation("ReportCreator", fields: [createdById], references: [id])
  approver        User?    @relation("ReportApprover", fields: [approvedById], references: [id])
  safety          SafetyReport?
  costs           Cost[]
  attachments     Attachment[]
  auditLogs       AuditLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== Safety Reports ====================
model SafetyReport {
  id                  String   @id @default(cuid())
  dailyReportId       String   @unique
  projectId           String
  reportDate          DateTime

  ppeAvailable        Boolean  @default(false)
  helmetCheck         Boolean  @default(false)
  bootsCheck          Boolean  @default(false)
  glovesCheck         Boolean  @default(false)
  glassesCheck        Boolean  @default(false)
  workAreaCheck       Boolean  @default(false)
  barriersCheck       Boolean  @default(false)
  shaftCheck          Boolean  @default(false)
  ventilationCheck    Boolean  @default(false)
  electricalCheck     Boolean  @default(false)
  craneCheck          Boolean  @default(false)
  hydraulicCheck      Boolean  @default(false)
  fireExtinguishers   Boolean  @default(false)
  workPermit          Boolean  @default(false)
  toolboxTalk         Boolean  @default(false)

  hazards             String?
  observations        String?
  violations          String?
  incidentType        String?
  incidentDescription String?

  signedBy            String?
  signedById          String?
  signedAt            DateTime?

  dailyReport         DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  project             Project  @relation(fields: [projectId], references: [id])
  signedByUser        User?    @relation("SafetyReportSigner", fields: [signedById], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ==================== Equipment ====================
model Equipment {
  id              String   @id @default(cuid())
  projectId       String?
  name            String
  number          String   @unique
  type            String
  status          String   @default("operational")
  dailyHours      Float    @default(0)
  breakdowns      String?
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  spareParts      String?
  notes           String?

  project         Project? @relation(fields: [projectId], references: [id])
  maintenance     EquipmentMaintenance[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EquipmentMaintenance {
  id            String   @id @default(cuid())
  equipmentId   String
  date          DateTime
  type          String
  description   String
  cost          Float    @default(0)
  partsUsed     String?
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
}

// ==================== Costs ====================
model Cost {
  id            String   @id @default(cuid())
  projectId     String
  dailyReportId String?
  date          DateTime
  category      String
  description   String
  amount        Float
  notes         String?

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyReport   DailyReport? @relation(fields: [dailyReportId], references: [id])
  recordedBy    User?    @relation(fields: [recordedById], references: [id])
  recordedById  String?

  createdAt     DateTime @default(now())
}

// ==================== Finishing / Handover ====================
model Finishing {
  id              String   @id @default(cuid())
  projectId       String
  driveLineId     String?
  date            DateTime
  siteCleaned     Boolean  @default(false)
  wasteRemoved    Boolean  @default(false)
  shaftClosed     Boolean  @default(false)
  siteRestored    Boolean  @default(false)
  lineHandover    Boolean  @default(false)
  clientNotes     String?
  handoverStatus  String   @default("pending")
  signedBy        String?
  signedById      String?
  signedAt        DateTime?

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signedByUser    User?    @relation(fields: [signedById], references: [id])
  attachments     Attachment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== Attachments ====================
model Attachment {
  id            String   @id @default(cuid())
  type          String
  fileName      String
  fileType      String
  url           String
  size          Int?
  dailyReportId String?
  finishingId   String?

  dailyReport   DailyReport? @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  finishing     Finishing?   @relation(fields: [finishingId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
}

// ==================== Notifications ====================
model Notification {
  id          String   @id @default(cuid())
  projectId   String?
  userId      String?
  type        String
  title       String
  message     String
  severity    String   @default("info")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  project     Project? @relation(fields: [projectId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
}

// ==================== Audit Log ====================
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  projectId   String?
  dailyReportId String?
  action      String
  entity      String
  entityId    String
  details     String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])
  dailyReport DailyReport? @relation(fields: [dailyReportId], references: [id])
}
